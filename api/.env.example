NODE_ENV                      = ${NODE_ENV:null}

ENV = ${ENV:null}
ENABLE_DEV_OTP = ${ENABLE_DEV_OTP:null}
GOOGLE_CLIENT_ID=

# CDC SSO (Keycloak) federated login.
# SSO_ISSUER_URL: realm URL that Keycloak sets as the token `iss` (exact match).
# SSO_CLIENT_ID:  the Keycloak client the frontend logs in with.
# SSO_ALLOWED_AUD: comma-separated audiences to accept (defaults to SSO_CLIENT_ID).
# Local dev stack example:
#   SSO_ISSUER_URL=http://localhost:1012/realms/auth
#   SSO_CLIENT_ID=pms-client
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_ALLOWED_AUD=

# WebAuthn / passkey login. RP_ID must be the bare hostname the frontend is
# served from (no scheme/port), e.g. "localhost" in dev. ORIGIN is the full
# origin including scheme+port, e.g. "http://localhost:4002" in dev.
# Both accept a comma-separated list, index-aligned with each other, to
# support multiple unrelated frontend domains at once. On registration/login
# option generation the server picks the RP_ID matching the caller's Origin
# header (falling back to the first entry if it doesn't match any).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=CamCyber PMS
WEBAUTHN_ORIGIN=http://localhost:4002
