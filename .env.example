# ==============================================================================
# DOCKER STACK CONFIGURATION (SINGLE SOURCE OF TRUTH)
# ==============================================================================
# All values must be defined here. Docker Compose is configured to enforce
# that every variable is provided directly from this file with NO fallback defaults.
# ==============================================================================

# ------------------------------------------------------------------------------
# HOST PORT MAPPINGS
# ------------------------------------------------------------------------------
# Port for Nginx Load Balancer on your Host/NAS (change if 80/443 are reserved by NAS)
PORT_HTTP=80
PORT_HTTPS=443

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
DB_CONNECTION=postgres
DB_HOST=postgres
DB_PORT=5432
DB_EXTERNAL_PORT=5433
DB_USERNAME=Muny
DB_PASSWORD=ChangeThisToStrongPassword123!
DB_DATABASE=wfm_db
DB_SYNCHRONIZE=true
DB_SSL=false

# ------------------------------------------------------------------------------
# CACHE & SESSIONS (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EXTERNAL_PORT=6380

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY KEYS (JWT / SESSIONS / ENCRYPTION)
# ------------------------------------------------------------------------------
# Generate strong, random secrets for production (e.g., via `openssl rand -hex 32`)
JWT_SECRET=super-secret-jwt-key-digitech-structure
JWT_REFRESH_SECRET=super-secret-refresh-jwt-key-digitech
JWT_EXPIRES=7d
JWT_REFRESH_EXPIRES=30d
REFRESH_TOKEN_ABSOLUTE_DAYS=30
REFRESH_TOKEN_IDLE_DAYS=7
MCP_API_KEY_DEFAULT_DAYS=90
CREDENTIAL_ENCRYPTION_KEY=your_64_character_hex_encryption_key_here
SESSION_SECRET=your_64_character_hex_session_secret_here
QR_HMAC_SECRET=your_64_character_hex_qr_hmac_secret_here

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
SYSTEM_NAME=Digitech PMS
ENVIRONMENT=PRODUCTION
PORT=3000
NODE_ENV=production
ENABLE_DEV_OTP=false
TRUST_PROXY=1

# Application URLs (Set to your NAS IP or Domain Name)
APP_BASE_URL=http://localhost
WEB_BASE_URL=http://localhost
FRONTEND_URL=http://localhost

# External Services
FILE_BASE_URL=https://file-v4-api.uat.camcyber.com

# WebAuthn / Passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Digitech PMS
WEBAUTHN_ORIGIN=http://localhost
